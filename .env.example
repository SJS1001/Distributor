HOST=127.0.0.1
PORT=3000
DATABASE_PATH=local-evidence/distributor.db
PUBLIC_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false
DATA_REGION=CA
# Outbound provider access is off until configured and customer exceptions accepted.
PROVIDERS_ENABLED=false
# Optional metadata consumer registration. Disabled omits processing and preserves any stored reports.
# Default enabled preserves earlier startup behavior; set disabled on every process for a disabled restore.
EVENT_REPORTS=enabled
# Separate foreground batch permission; no scheduler or provider sends.
LOCAL_EVENT_REPORTS=disabled
# One trusted organization/account binding; use a separate runtime/store per region.
# PROVIDER_BINDING_ID=your-binding-name
# PROVIDER_ORG_ID=organization-uuid
# PROVIDER_WORKER_USER_ID=active-finance-user-uuid
# STRIPE_TEST_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# QUICKBOOKS_REALM_ID=sandbox-company-id
# QUICKBOOKS_ACCESS_TOKEN=short-lived-sandbox-token
# Optional managed sandbox credentials: omit QUICKBOOKS_ACCESS_TOKEN in this mode.
# QUICKBOOKS_CREDENTIAL_MODE=managed
# QUICKBOOKS_CLIENT_ID=your-sandbox-client-id
# QUICKBOOKS_CLIENT_SECRET=your-sandbox-client-secret
# Initial operator authorization also requires an exact customer account and registered callback.
# PROVIDER_ACCOUNT_ID=customer-account-uuid
# QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:3000/quickbooks/callback
# No callback listener is installed; supply the captured callback via protected stdin.
# PROVIDER_ENCRYPTION_KEY=64-hex-characters-from-your-approved-secret-store
# Retain the same separate key across API/worker restarts; see docs/PROVIDERS.md.
# Demo data is installed only by the explicit demo command. Never use real customer data.

# Optional authenticator enrollment; exactly 64 hex characters (32 random bytes).
# Supply securely outside the database; keep the same key across API processes/restarts.
# Unset disables enrollment and fails closed for existing authenticator users.
# MFA_ENCRYPTION_KEY=

# Optional role policy: exact comma-separated roles, no spaces/duplicates.
# Requires MFA_ENCRYPTION_KEY. Unset/empty keeps enrollment optional.
# Example only; choose required roles in the reviewed operating policy.
# MFA_REQUIRED_ROLES=admin,finance
