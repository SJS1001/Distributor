HOST=127.0.0.1
PORT=3000
DATABASE_PATH=local-evidence/distributor.db
PUBLIC_ORIGIN=http://127.0.0.1:3000
SECURE_COOKIES=false
DATA_REGION=CA
# Payment/accounting provider access is off until configured and customer exceptions accepted.
PROVIDERS_ENABLED=false
# Optional metadata consumer registration. Disabled omits processing and preserves any stored reports.
# Default enabled preserves earlier startup behavior; set disabled on every process for a disabled restore.
EVENT_REPORTS=enabled
# Separate foreground batch permission; no scheduler or provider sends.
LOCAL_EVENT_REPORTS=disabled
# One trusted organization/account binding; use a separate runtime/store per region.
# PROVIDER_BINDING_ID=your-binding-name
# PROVIDER_ORG_ID=organization-uuid
# PROVIDER_WORKER_USER_ID=active-finance-user-uuid
# STRIPE_TEST_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# QUICKBOOKS_REALM_ID=sandbox-company-id
# QUICKBOOKS_ACCESS_TOKEN=short-lived-sandbox-token
# Optional managed sandbox credentials: omit QUICKBOOKS_ACCESS_TOKEN in this mode.
# QUICKBOOKS_CREDENTIAL_MODE=managed
# QUICKBOOKS_CLIENT_ID=your-sandbox-client-id
# QUICKBOOKS_CLIENT_SECRET=your-sandbox-client-secret
# Initial operator authorization also requires an exact customer account and registered callback.
# PROVIDER_ACCOUNT_ID=customer-account-uuid
# QUICKBOOKS_REDIRECT_URI=http://127.0.0.1:3000/quickbooks/callback
# Optional browser flow: same login, configured company/customer and explicit Finish.
# QUICKBOOKS_BROWSER_AUTH_ENABLED=false
# Requires PROVIDERS_ENABLED=true and QUICKBOOKS_CREDENTIAL_MODE=managed.
# Callback must be PUBLIC_ORIGIN + /quickbooks/callback; build the web app first.
# The separate CLI flow accepts captured callbacks through protected stdin.
# PROVIDER_ENCRYPTION_KEY=64-hex-characters-from-your-approved-secret-store
# Retain the same separate key across API/worker restarts; see docs/PROVIDERS.md.
# Demo data is installed only by the explicit demo command. Never use real customer data.

# Optional authenticator enrollment; exactly 64 hex characters (32 random bytes).
# Supply securely outside the database; keep the same key across API processes/restarts.
# Unset disables enrollment and fails closed for existing authenticator users.
# MFA_ENCRYPTION_KEY=

# Optional role policy: exact comma-separated roles, no spaces/duplicates.
# Requires MFA_ENCRYPTION_KEY. Unset/empty keeps enrollment optional.
# Example only; choose required roles in the reviewed operating policy.
# MFA_REQUIRED_ROLES=admin,finance

# Independent carrier boundary; false performs no configuration/provider I/O.
# Enabling this does not require PROVIDERS_ENABLED or payment/accounting credentials.
CARRIERS_ENABLED=false
UPS_SANDBOX_ENABLED=false
FEDEX_SANDBOX_ENABLED=false
USPS_TEM_ENABLED=false
DHL_TEST_ENABLED=false
# CARRIER_ORG_ID=existing-organization-uuid-in-this-regional-store
# Selected carriers require every field below, supplied through approved secret/config storage.
# UPS_CLIENT_ID=your-sandbox-client-id
# UPS_CLIENT_SECRET=your-sandbox-client-secret
# UPS_SHIPPER_NUMBER=your-six-character-uppercase-account
# UPS_SHIPPER_JSON=exact registered contact JSON (see docs/CARRIER-BOOKINGS.md)
# UPS_SERVICES_JSON=exact reviewed service/code array (see runbook)
# FEDEX_CLIENT_ID=your-sandbox-client-id
# FEDEX_CLIENT_SECRET=your-sandbox-client-secret
# FEDEX_ACCOUNT_NUMBER=your-nine-digit-account
# FEDEX_COUNTRY=CA
# FEDEX_PICKUP_TYPE=DROPOFF_AT_FEDEX_LOCATION
# FEDEX_SERVICES_JSON=exact reviewed service/code/residential array (see runbook)
# USPS uses the fixed TEM gateway; accounts/credentials may also serve production.
# Explicit acknowledgment is an endpoint restriction, not proof of credential class.
# USPS_TEM_CREDENTIALS_ACK=tem-only
# USPS_CLIENT_ID=your-approved-client-id
# USPS_CLIENT_SECRET=your-approved-client-secret
# USPS_CRID=your-numeric-customer-registration-id
# USPS_MID=your-six-or-nine-digit-mailer-id
# USPS_MANIFEST_MID=your-six-or-nine-digit-manifest-mailer-id
# USPS_EPS_ACCOUNT=your-numeric-enterprise-payment-account
# USPS_MAILING_DATE=operator-reviewed-YYYY-MM-DD
# USPS_SERVICES_JSON=[{"service":"Reviewed domestic parcel","code":"USPS_GROUND_ADVANTAGE","processingCategory":"NONSTANDARD"}]
# Mailing date/service eligibility must be reviewed for each activation; no scheduler.
# DHL uses only the fixed MyDHL test gateway; activation requires qualified test credentials.
# DHL_TEST_CREDENTIALS_ACK=test-only
# DHL_USERNAME=your-approved-test-username
# DHL_PASSWORD=your-approved-test-password
# DHL_ACCOUNT_NUMBER=your-reviewed-shipping-account
# DHL_COUNTRY=CA
# Exact operator-qualified product/local-product/destination mappings; no default codes.
# DHL_SERVICES_JSON=exact reviewed service/productCode/localProductCode/destinationCountry array (see runbook)
# Preparation must include explicit companies, future shipping time/offset and goods review.
# Cross-border customs also requires explicit invoice type; no inferred values or FX.
# No production carrier endpoints, default services or scheduled purchases are configured.

# Canada Post grouped contract shipping: separate warehouse-specific test opt-in.
CANADA_POST_TEST_ENABLED=false
# Uses CARRIERS_ENABLED and CARRIER_ORG_ID above. No startup requests or worker.
# Test and production applications share a gateway; this acknowledgement cannot
# prove credential class. Vendor/account/service/residency qualification is required.
# CANADA_POST_TEST_CREDENTIALS_ACK=test-application-only
# CANADA_POST_WAREHOUSE_ID=warehouse-uuid-in-configured-organization
# CANADA_POST_CLIENT_ID=your-test-application-client-id
# CANADA_POST_CLIENT_SECRET=your-test-application-secret
# CANADA_POST_CUSTOMER_NUMBER=your-7-to-10-digit-customer-number
# CANADA_POST_CONTRACT_ID=your-1-to-10-digit-contract-id
# CANADA_POST_COMPANY=your-reviewed-company-name
# Exact pickup postal codes have no spaces; deposit site IDs have four uppercase letters/digits.
# CANADA_POST_SHIPPING_POINT_JSON={"kind":"pickup","postalCode":"M5V1A1"}
# CANADA_POST_SHIPPING_POINT_JSON={"kind":"deposit","siteId":"A1B2"}
# CANADA_POST_SERVICES_JSON=[{"service":"Reviewed domestic parcel","code":"DOM.RP"}]
# Alternative: 1–20 exact warehouse registrations, at most 16,384 JSON characters.
# Omit ALL six legacy origin fields above (WAREHOUSE_ID, CUSTOMER_NUMBER, CONTRACT_ID,
# COMPANY, SHIPPING_POINT_JSON, SERVICES_JSON) when using the list, even if empty.
# Credential references are environment variable names; never put secret values in JSON.
# CANADA_POST_WAREHOUSES_JSON=[{"warehouseId":"first-warehouse-uuid","customerNumber":"1234567","contractId":"123456","company":"Reviewed first company","shippingPoint":{"kind":"pickup","postalCode":"M5V1A1"},"services":[{"service":"Reviewed domestic parcel","code":"DOM.RP"}],"clientIdEnv":"CANADA_POST_ORIGIN_A_ID","clientSecretEnv":"CANADA_POST_ORIGIN_A_SECRET"},{"warehouseId":"second-warehouse-uuid","customerNumber":"7654321","contractId":"654321","company":"Reviewed second company","shippingPoint":{"kind":"deposit","siteId":"A1B2"},"services":[{"service":"Reviewed domestic parcel","code":"DOM.RP"}],"clientIdEnv":"CANADA_POST_ORIGIN_B_ID","clientSecretEnv":"CANADA_POST_ORIGIN_B_SECRET"}]
# CANADA_POST_ORIGIN_A_ID=your-first-test-application-client-id
# CANADA_POST_ORIGIN_A_SECRET=your-first-test-application-secret
# CANADA_POST_ORIGIN_B_ID=your-second-test-application-client-id
# CANADA_POST_ORIGIN_B_SECRET=your-second-test-application-secret
# Group preparation captures this configuration. Changing account/warehouse/services
# prevents old groups from dispatching under the new configuration.
